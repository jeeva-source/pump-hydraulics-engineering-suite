{
  "name": "pump-hydraulics-engineering-suite",
  "version": "4.0.0",
  "description": "Desktop pump hydraulics engineering suite with vendor curve and operating point analysis",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "test:curve": "node tests/curve-engine-smoke.js"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.just.pumphydraulics",
    "productName": "Pump Hydraulics Engineering Suite",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
