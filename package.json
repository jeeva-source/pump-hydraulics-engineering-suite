{
  "name": "pump-hydraulics-engineering-suite",
  "version": "5.6.0",
  "description": "Pump hydraulics suite with pipe-derived system curves, connected networks, pump performance, selection, NPSH and configurations",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "test:v5": "node tests/hydraulics-v5.test.js",
    "test:v5.1": "node tests/hydraulics-v5-1.test.js",
    "test:v5.2": "node tests/network-v5-2.test.js",
    "test": "npm run test:v5 && npm run test:v5.1 && npm run test:v5.2 && npm run test:v5.3 && npm run test:v5.4 && npm run test:v5.5 && npm run test:v5.6",
    "test:v5.3": "node tests/pump-performance-v5-3.test.js",
    "test:v5.4": "node tests/pump-selection-v5-4.test.js",
    "test:v5.5": "node tests/pump-configurations-v5-5.test.js",
    "test:v5.6": "node tests/pipe-system-curve-v5-6.test.js"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.just.pumphydraulics",
    "productName": "Pump Hydraulics Engineering Suite",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
