{
  "name": "pump-hydraulics-engineering-suite",
  "version": "5.2.0",
  "description": "Pump hydraulics engineering suite with serial, network and pump-system hydraulic calculation engines",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "test:v5": "node tests/hydraulics-v5.test.js",
    "test:v5.1": "node tests/hydraulics-v5-1.test.js",
    "test:v5.2": "node tests/network-v5-2.test.js",
    "test": "npm run test:v5 && npm run test:v5.1 && npm run test:v5.2"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.just.pumphydraulics",
    "productName": "Pump Hydraulics Engineering Suite",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
